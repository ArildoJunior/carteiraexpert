{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "warn",
        "noVar": "error"
      },
      "style": {
        "useConst": "error",
        "useSingleVarDeclarator": "error",
        "noUselessElse": "error",
        "useBlockStatements": "error"
      },
      "complexity": {
        "noForEach": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules/",
      "!**/.next/",
      "!**/dist/",
      "!**/pnpm-lock.yaml",
      "!**/*.d.ts"
    ]
  }
}
