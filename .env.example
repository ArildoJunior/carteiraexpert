# ──────────────────────────────────────────────────────────
# CarteiraExpert — modelo de variáveis de ambiente
# Revisão: 2026-08-12
#
# Instruções:
# 1. Copie este arquivo para .env.
# 2. Substitua os valores "replace-with-..." pelas configurações reais.
# 3. Nunca versione o arquivo .env.
# 4. Use PUBLIC quando o provedor não exigir autenticação.
# ──────────────────────────────────────────────────────────

# ─── Banco de dados ───────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
DATABASE_URL_TEST="postgresql://USER:PASSWORD@HOST:5432/DATABASE_TEST"
NODE_ENV="development"

# ─── Aplicação e autenticação ─────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_RATE_LIMIT_SECRET="replace-with-a-long-random-hmac-secret-min-32-chars"

# ─── LLM primário ─────────────────────────────────────────
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_MAX_TOKENS="2000"
OPENAI_TEMPERATURE="0.2"
OPENAI_TIMEOUT_MS="30000"

# ─── LLM alternativo ──────────────────────────────────────
ANTHROPIC_API_KEY="replace-with-anthropic-api-key"
CLAUDE_MODEL="claude-haiku-4-5"
CLAUDE_MAX_TOKENS="2000"

# ─── Armazenamento ────────────────────────────────────────
# Preencher somente após criar o Blob Store.
BLOB_STORE_ID="replace-with-blob-store-id"
BLOB_READ_WRITE_TOKEN="replace-with-blob-read-write-token"

# ─── Observabilidade ──────────────────────────────────────
# Deixar vazio enquanto esses serviços não forem utilizados.
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""

# ─── E-mail ───────────────────────────────────────────────
RESEND_API_KEY="replace-with-resend-api-key"

# ══════════════════════════════════════════════════════════
# Provedores de dados
# Ordem esperada: provedor primário → provedor alternativo.
# ══════════════════════════════════════════════════════════

# ─── Ações brasileiras ────────────────────────────────────
BRAPI_TOKEN="replace-with-brapi-token"
HG_BRASIL_TOKEN="replace-with-hg-brasil-token"
B3_CVM_TOKEN="PUBLIC"

# ─── Fundos imobiliários ──────────────────────────────────
FII_B3_CVM_TOKEN="PUBLIC"

# ─── Cripto — dados on-chain ──────────────────────────────
COINGECKO_DEMO_API_KEY="replace-with-coingecko-demo-api-key"
COINCAP_TOKEN="PUBLIC"

# ─── Cripto — exchanges ───────────────────────────────────
BINANCE_TOKEN="PUBLIC"
KRAKEN_TOKEN="PUBLIC"

# ─── Ações dos Estados Unidos ─────────────────────────────
FINNHUB_TOKEN="replace-with-finnhub-token"
ALPHA_VANTAGE_TOKEN="replace-with-alpha-vantage-token"

# ─── Ações globais ────────────────────────────────────────
TWELVE_DATA_TOKEN="replace-with-twelve-data-token"

# ─── Dividendos brasileiros ───────────────────────────────
DIVIDENDOS_BR_B3_CVM_TOKEN="PUBLIC"
DIVIDENDOS_BR_BRAPI_TOKEN="PUBLIC"
DIVIDENDOS_BR_EMPRESA_TOKEN="PUBLIC"

# ─── Dividendos dos Estados Unidos ────────────────────────
DIVIDENDOS_EUA_SEC_TOKEN="PUBLIC"
DIVIDENDOS_EUA_FMP_TOKEN="replace-with-fmp-token"
DIVIDENDOS_EUA_YAHOO_TOKEN="PUBLIC"

# ─── Provedor canônico de cotações ────────────────────────
FINANCIAL_MODELING_PREP_TOKEN="replace-with-financial-modeling-prep-token"

# ─── Câmbio — BRL ─────────────────────────────────────────
BC_PTAX_TOKEN="PUBLIC"
HG_BRASIL_CAMBIO_TOKEN="replace-with-hg-brasil-token"
FRANKFURTER_TOKEN="PUBLIC"

# ─── Indicadores econômicos ───────────────────────────────
BC_SGS_TOKEN="PUBLIC"
IBGE_TOKEN="PUBLIC"
IPEADATA_TOKEN="PUBLIC"

# ─── Fundamentos brasileiros ──────────────────────────────
CVM_FUNDAMENTOS_TOKEN="PUBLIC"
B3_FUNDAMENTOS_TOKEN="PUBLIC"
BRAPI_FUNDAMENTOS_TOKEN="replace-with-brapi-token"

# ─── Fundamentos dos Estados Unidos ───────────────────────
SEC_EDGAR_TOKEN="PUBLIC"
FINNHUB_FUNDAMENTOS_TOKEN="replace-with-finnhub-token"

# ─── Reuso de credenciais ─────────────────────────────────
# Estes valores devem receber a mesma credencial do provedor
# correspondente quando o sistema exigir variáveis separadas.
FMP_FUNDAMENTOS_TOKEN="replace-with-financial-modeling-prep-token"

# ─── Contato público de segurança ─────────────────────────
SEC_CONTACT_EMAIL="security@example.com"
