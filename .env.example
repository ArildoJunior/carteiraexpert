# Ambiente
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Banco de dados (Neon/Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/carteiraexpert"

# NextAuth
AUTH_SECRET="troque-por-uma-string-aleatoria-de-32-caracteres"
AUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@carteiraexpert.com"

# Upstash Redis (acelerador de leitura — opcional, sem fallback obrigatório)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cap 6 — Provedores de dados financeiros
BRAPI_TOKEN=""

# Cap 6 — Intervalos de refresh por categoria (segundos)
QUOTE_REFRESH_INTERVAL_BR_SEC="300"          # 5 min durante o pregao
QUOTE_REFRESH_INTERVAL_US_SEC="300"          # 5 min
QUOTE_REFRESH_INTERVAL_CRYPTO_SEC="300"      # 5 min
QUOTE_REFRESH_INTERVAL_FUNDAMENTAL_SEC="900" # 15 min
QUOTE_REFRESH_INTERVAL_DIVIDEND_SEC="3600"   # 60 min

# Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# LLM
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Insights
INSIGHT_ACCESS_LIMIT_FREE="5"
INSIGHT_ACCESS_LIMIT_PRO="50"
DOC_ANALYSIS_TTL_HOURS="24"
# Processamento documental com IA
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_MS=30000

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_TOKENS=2000